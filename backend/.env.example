# Cicero example environment file.
# Copy to `.env` (which is git-ignored) and fill in as needed.
# NEVER commit real secrets — this file documents variable NAMES only.

# --- Persistence ---
# SQLite by default; swap to Postgres, etc. via a SQLAlchemy URL.
DATABASE_URL=sqlite:///./cicero.db

# --- Providers ---
# Your own Anthropic API key (required only to use the Anthropic provider).
ANTHROPIC_API_KEY=
# Base URL of your local Ollama server.
OLLAMA_HOST=http://localhost:11434

# --- API surface (localhost by default) ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma/JSON list of allowed CORS origins for the frontend dev server.
# CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- API hardening ---
# Optional bearer token; when set, every request (except /health) must send
# "Authorization: Bearer <token>". Recommended for any non-localhost use.
# API_AUTH_TOKEN=
# Requests per client IP per minute (0 disables rate limiting).
RATE_LIMIT_PER_MINUTE=240

# --- Debate budgets (defaults for new chambers; per-chamber settings override) ---
MAX_ROUNDS=8
MAX_TOTAL_TOKENS=200000
TURN_TIMEOUT_SECONDS=120

# --- Web evidence (OFF by default; also opt-in per chamber) ---
WEB_ACCESS_ENABLED=false
# Only these domains may be fetched when web access is on (JSON list).
# WEB_DOMAIN_ALLOWLIST=["en.wikipedia.org","arxiv.org"]
# Domains that are always blocked, even if allowlisted (JSON list).
# WEB_DOMAIN_DENYLIST=[]
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_MAX_RESPONSE_BYTES=2000000
# How many web sources are gathered per debate (1-10).
WEB_MAX_RESULTS=3
